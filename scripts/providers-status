#!/usr/bin/env python3
"""Check provider configuration and connectivity.

Usage:
  scripts/providers-status                    # show all providers (table)
  scripts/providers-status <provider>         # check one provider (table row)
  scripts/providers-status <provider> <field> # print single field (configured|reachable|notes)

The provider list is derived dynamically from PluginManifest: every provider
that declares a ``connectivity`` command appears.

``configured`` is computed by the core provider FSM (``core/fsm/provider.yaml``) from
eve-resolved config — true iff the provider's *required* config/secrets are present —
so it can never be a plugin's ambient self-report (v4.5 N/O). ``reachable`` comes from
the provider's ``connectivity`` command, run on the HOST only when configured; the
command's own ``configured`` field is ignored (it only needs to answer reachability).
"""
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from eve_sdk.dispatch import command_env, command_vector  # noqa: E402
from eve_sdk.fsm import EveFsm, provider_configured_resolver  # noqa: E402
from eve_sdk.plugin_manifest import PluginManifest  # noqa: E402
from eve_sdk.provider_command import resolved_provider_environment  # noqa: E402

CORE_PROVIDER_MACHINE = ROOT / "core" / "fsm" / "provider.yaml"

HEADER = "Provider           Configured  Reachable  Notes"
SEPARATOR = "-----------------  ----------  ---------  -------------------------------------------"


def _connectivity_providers() -> list[dict[str, Any]]:
    """Return provider plugins that declare a connectivity command, sorted by id."""
    return sorted(
        (
            PluginManifest.public(p)
            for p in PluginManifest.load_all("provider")
            if "connectivity" in (p.get("commands") or {})
        ),
        key=lambda p: p["id"],
    )


def _run_connectivity(plugin: dict[str, Any]) -> tuple[str, str, str]:
    """Run a provider's connectivity command, parse JSON → (configured, reachable, notes)."""
    spec = plugin["commands"]["connectivity"]
    cmd = command_vector(plugin, spec)
    # Use the same shared environment builder as provider dispatch, including
    # ConfigEnv settings and injected secrets (v4.5 M/O: status == dispatch).
    env = resolved_provider_environment(str(plugin["id"]), plugin)
    result = subprocess.run(
        cmd,
        env=command_env(env),
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return "no", "no", f"connectivity check failed (exit {result.returncode})"
    try:
        data = json.loads(result.stdout)
        return str(data.get("configured", "no")), str(data.get("reachable", "no")), str(data.get("notes", ""))
    except (json.JSONDecodeError, ValueError):
        return "no", "no", "connectivity check returned invalid JSON"


def _print_row(name: str, configured: str, reachable: str, notes: str) -> None:
    print(f"{name:<17}  {configured:<10}  {reachable:<9}  {notes}")


def _provider_status(plugin: dict[str, Any]) -> tuple[str, str, str]:
    """(configured, reachable, notes) via the core provider FSM (v4.5 N/O).

    ``configured`` is FSM-derived — true iff eve has resolved the provider's *required*
    config/secrets (``provider_configured_resolver``) — so it can never be a connectivity
    command's ambient self-report. The connectivity probe runs only when configured, and
    only its ``reachable`` + ``notes`` are used.
    """
    provider_id = str(plugin["id"])
    fsm = EveFsm(provider_configured_resolver())
    fsm.load("provider", CORE_PROVIDER_MACHINE.read_text())
    fsm.fire("provider", provider_id, "resolve")
    if fsm.state("provider", provider_id) == "unconfigured":
        return "no", "no", "not configured"
    _configured, reachable, notes = _run_connectivity(plugin)
    fsm.fire("provider", provider_id, "probe_ok" if reachable == "yes" else "probe_fail")
    reachable = "yes" if fsm.state("provider", provider_id) == "reachable" else "no"
    return "yes", reachable, notes


def main(argv: list[str]) -> int:
    provider_name = argv[0] if len(argv) > 0 else ""
    field = argv[1] if len(argv) > 1 else ""

    providers = _connectivity_providers()
    provider_ids = [p["id"] for p in providers]

    if provider_name:
        if provider_name not in provider_ids:
            print(f"Unknown provider: {provider_name} (valid: {' '.join(provider_ids)})", file=sys.stderr)
            return 1
        plugin = next(p for p in providers if p["id"] == provider_name)
        configured, reachable, notes = _provider_status(plugin)
        if field:
            if field == "configured":
                print(configured)
            elif field == "reachable":
                print(reachable)
            elif field == "notes":
                print(notes)
            else:
                print(
                    f"Unknown field: {field} (valid: configured, reachable, notes)",
                    file=sys.stderr,
                )
                return 1
        else:
            print(HEADER)
            print(SEPARATOR)
            _print_row(provider_name, configured, reachable, notes)
    else:
        print(HEADER)
        print(SEPARATOR)
        for plugin in providers:
            configured, reachable, notes = _provider_status(plugin)
            _print_row(plugin["id"], configured, reachable, notes)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
