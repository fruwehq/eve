#!/usr/bin/env python3
"""Upload the OS-appropriate provisioning tree to the profile's instance
and run the bootstrap entry point.

Usage: scripts/provision <instance>

Ubuntu: uploads ./oses/<catalog-os-id>/provision/ -> $HOME/provision
Windows: uploads ./oses/<catalog-os-id>/provision/ -> C:\\Users\\<user>\\provision
"""

from __future__ import annotations

import hashlib
import json
import os
import shlex
import subprocess
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path
from shutil import copy2, copytree

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from eve_sdk.config import ConfigEnv  # noqa: E402
from eve_sdk.instance_dispatch import load_runtime_env  # noqa: E402
from eve_sdk.package_dispatch import (  # noqa: E402
    package_environment_names,
    resolved_package_set_environment,
)
from eve_sdk.plugin_manifest import PluginManifest  # noqa: E402
from eve_sdk.resolve import instance_package_config  # noqa: E402
from eve_sdk.secrets import windows_secret_cleanup, write_private_text  # noqa: E402


def _provision_dir_display(path: Path, root: Path) -> str:
    """Display the provision dir relative to root, or full path if external."""
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def _run(cmd: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
    """Run a subprocess in ROOT, forwarding stderr by default."""
    return subprocess.run(cmd, cwd=ROOT, text=True, **kwargs)  # type: ignore[arg-type]


def _ssh_retry(profile: str, label: str, remote_cmd: str) -> int:
    return _run([
        str(ROOT / "scripts/ssh-retry"), label,
        str(ROOT / "scripts/instance-ssh"), profile, "--", remote_cmd,
    ], stderr=None).returncode


def _ssh_retry_scp(profile: str, label: str, source: str, dest: str) -> int:
    return _run([
        str(ROOT / "scripts/ssh-retry"), label,
        str(ROOT / "scripts/instance-ssh"), profile, "--scp", source, dest,
    ], stderr=None).returncode


def _parse_env(output: str) -> dict[str, str]:
    env: dict[str, str] = {}
    for line in output.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        env[key] = value
    return env


def _env_line(key: str, value: str, *, remote_home: bool = False) -> str:
    if remote_home:
        return f'export {key}="$HOME"/{shlex.quote(value.removeprefix("$HOME/"))}'
    return f"export {key}={shlex.quote(value)}"


def _write_private_text(path: Path, value: str) -> None:
    write_private_text(path, value)


def _selected_packages(bundle_packages: str) -> list[str]:
    return [pkg for pkg in bundle_packages.split(",") if pkg]


def _selected_package_environment(
    plugin_doc: dict,
    bundle_packages: str,
    profile: str,
) -> tuple[list[dict], dict[str, str]]:
    selected = set(_selected_packages(bundle_packages))
    plugins = [
        plugin
        for plugin in plugin_doc.get("plugins") or []
        if isinstance(plugin, dict) and str(plugin.get("id")) in selected
    ]
    all_config = instance_package_config(profile)
    selected_config = {
        package_id: value
        for package_id, value in all_config.items()
        if package_id in selected
    }
    return plugins, resolved_package_set_environment(plugins, selected_config)


def _plugin_ubuntu_steps(plugin_doc: dict, bundle_packages: str) -> list[tuple[str, str]]:
    """Return [(plugin_path, step_name)] in selection order from BUNDLE_PACKAGES."""
    selected = _selected_packages(bundle_packages)
    by_id = {p["id"]: p for p in plugin_doc.get("plugins") or []}
    result: list[tuple[str, str]] = []
    for package_id in selected:
        plugin = by_id.get(package_id)
        if not plugin:
            continue
        for step in (plugin.get("install") or {}).get("ubuntu", {}).get("steps") or []:
            result.append((plugin["path"], step))
    return result


def _plugin_windows_steps(plugin_doc: dict, bundle_packages: str) -> list[tuple[str, str]]:
    selected = _selected_packages(bundle_packages)
    by_id = {p["id"]: p for p in plugin_doc.get("plugins") or []}
    result: list[tuple[str, str]] = []
    for package_id in selected:
        plugin = by_id.get(package_id)
        if not plugin:
            continue
        for step in (plugin.get("install") or {}).get("windows", {}).get("steps") or []:
            # For dual-OS packages, the merged plugin's path points to the
            # Linux half. The Windows provision files live in the Windows half
            # (os_paths.windows). Use that path when available.
            os_paths = plugin.get("os_paths") or {}
            path = os_paths.get("windows") or plugin["path"]
            result.append((path, step))
    return result


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def _write_manifest(state_dir: Path, steps: list[dict], os_family: str) -> None:
    manifest = {
        "api_version": 1,
        "os_family": os_family,
        "created_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "steps": steps,
    }
    (state_dir / "provision-manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8"
    )


def provision_ubuntu(profile: str, env: dict[str, str], root: Path) -> int:
    os_family = env.get("OS_FAMILY", "")
    os_id = env.get("OS_ID", "")
    bundle_packages = env.get("BUNDLE_PACKAGES", "")
    profile_name = env.get("PROFILE_NAME", "")
    provider = env.get("PROVIDER", "")
    os_provision_dir = PluginManifest.os_provision_dir(os_id)
    if os_provision_dir is None:
        os_provision_dir = root / "oses" / os_id / "provision"

    if not os_provision_dir.is_dir():
        display = _provision_dir_display(os_provision_dir, root)
        print(f"[provision] OS provisioning directory not found: {display}", file=sys.stderr)
        return 2

    ssh_wait_rc = _run([str(root / "scripts/ssh-wait"), profile]).returncode
    if ssh_wait_rc != 0:
        return ssh_wait_rc

    instance_ssh = str(root / "scripts/instance-ssh")

    def check_sudo() -> bool:
        return subprocess.run(
            [instance_ssh, profile, "--", "sudo -n true"],
            cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        ).returncode == 0

    if not check_sudo():
        # A provider may declare a bootstrap password (via its manifest, read
        # generically by _bootstrap_sudo_password) used to install NOPASSWD
        # sudo on first contact. Core names no provider here.
        bootstrap_password = ConfigEnv.bootstrap_sudo_password(provider)
        if bootstrap_password:
            print("[provision] configuring passwordless sudo via the provider's bootstrap password")
            remote_cmd = (
                'tmp=$(mktemp); printf "%s ALL=(ALL) NOPASSWD:ALL\\n" "$USER" > "$tmp"; '
                'chmod 0440 "$tmp"; sudo -S -p "" install -o root -g root -m 0440 "$tmp" '
                '/etc/sudoers.d/90-eve-provision; rm -f "$tmp"; '
                'sudo -n visudo -cf /etc/sudoers.d/90-eve-provision'
            )
            subprocess.run(
                [instance_ssh, profile, "--", remote_cmd],
                cwd=root, input=f"{bootstrap_password}\n", text=True, check=False,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )

    if not check_sudo():
        print(
            "[provision] Linux provisioning requires passwordless sudo"
            " for the SSH user.", file=sys.stderr,
        )
        print(
            "[provision] Configure the provider's bootstrap password or passwordless"
            f" sudo for the SSH user on {profile}, then retry.", file=sys.stderr,
        )
        return 1

    stage = Path(tempfile.mkdtemp())
    try:
        copytree(os_provision_dir / "scripts", stage / "scripts")
        (stage / "state").mkdir(parents=True, exist_ok=True)
        for f in (stage / "scripts" / "steps").glob("*.sh"):
            f.unlink()

        ordered_steps: list[str] = []
        ordered_roots: list[str] = []
        step_set: set[str] = set()

        def add_step(step: str, plugin_root: str) -> None:
            if step in step_set:
                return
            step_set.add(step)
            ordered_steps.append(step)
            ordered_roots.append(plugin_root)

        add_step("base.sh", "")
        add_step("human-user.sh", "")
        add_step("timezone.sh", "")

        plugin_doc = json.loads(subprocess.run(
            [str(root / "scripts/plugin-list"), "--kind", "package", "--json"],
            cwd=root, capture_output=True, text=True, check=False,
        ).stdout)
        selected_plugins, package_env = _selected_package_environment(
            plugin_doc, bundle_packages, profile
        )
        for plugin_path, step in _plugin_ubuntu_steps(plugin_doc, bundle_packages):
            if not plugin_path:
                continue
            if step in ("base.sh", "human-user.sh", "timezone.sh", "finish.sh"):
                continue
            add_step(step, str(Path(plugin_path).parent))

        add_step("finish.sh", "")

        steps_dir = stage / "scripts" / "steps"
        for idx, step in enumerate(ordered_steps):
            plugin_root = ordered_roots[idx]
            target = steps_dir / Path(step).name
            source: Path | None = None
            os_step = os_provision_dir / "scripts" / "steps" / step
            if os_step.is_file():
                source = os_step
            elif plugin_root:
                plugin_step = Path(plugin_root) / step
                if plugin_step.is_file():
                    source = plugin_step
            if source is None:
                print(f"[provision] install step not found: {step}", file=sys.stderr)
                return 2
            copy2(source, target)

        (stage / "state" / "steps.list").write_text(
            "\n".join(Path(s).name for s in ordered_steps) + "\n", encoding="utf-8"
        )

        manifest_steps: list[dict] = []
        for idx, step in enumerate(ordered_steps):
            step_file = steps_dir / Path(step).name
            manifest_steps.append({
                "order": idx,
                "name": Path(step).name,
                "sha256": _sha256(step_file),
            })
        _write_manifest(stage / "state", manifest_steps, os_family)

        pkg_lines = "\n".join(_selected_packages(bundle_packages))
        (stage / "state" / "bundle_packages").write_text(pkg_lines + "\n", encoding="utf-8")
        (stage / "state" / "selected_packages").write_text(pkg_lines + "\n", encoding="utf-8")

        # Stage package type:path config files (local installer files a package
        # needs on the remote) onto the remote and rewrite each env var to its
        # remote path — generic, so core names no package. Captured as
        # (local_path, remote_rel_dir) and uploaded after the provision dir is
        # prepared, below.
        stage_files: list[tuple[str, str]] = []
        stage_env_names = package_environment_names(selected_plugins, path_config_only=True)
        for stage_var in stage_env_names:
            local_path = package_env.get(stage_var, "")
            if not local_path:
                continue
            if not Path(local_path).exists():
                print(f"[provision] {stage_var} does not exist: {local_path}", file=sys.stderr)
                return 2
            remote_rel = f"provision/downloads/{stage_var.lower()}"
            package_env[stage_var] = f"$HOME/{remote_rel}/{os.path.basename(local_path)}"
            stage_files.append((local_path, remote_rel))

        host_tz = package_env.get("TIMEZONE", "")
        if not host_tz:
            tz_result = subprocess.run(
                [str(root / "scripts/host-timezone")], cwd=root,
                capture_output=True, text=True, check=False,
            )
            if tz_result.returncode == 0:
                host_tz = tz_result.stdout.strip()

        # Core (non-plugin) provision env. Plugin env is appended generically
        # below so core names no provider or package (v4.4 §15.5).
        env_lines = [
            _env_line("ACCESS_BOOTSTRAP_USER", env.get("ACCESS_BOOTSTRAP_USER", "")),
            _env_line("ACCESS_HUMAN_USER", env.get("ACCESS_HUMAN_USER", "")),
            _env_line("ACCESS_PROVISION_USER", env.get("ACCESS_PROVISION_USER", "")),
            _env_line("OS_FAMILY", os_family),
            _env_line("PROFILE_NAME", profile_name),
            _env_line("HUMAN_USER_NAME", env.get("HUMAN_USER_NAME", "")),
            _env_line("PROVISION_USER_NAME", env.get("PROVISION_USER_NAME", "")),
            _env_line("VM_USER_NAME", env.get("VM_USER_NAME", "")),
            _env_line("VM_USER_PASSWORD", os.environ.get("VM_USER_PASSWORD", "")),
            _env_line("EPHEMERAL_DISPLAY_RESOLUTION", package_env.get("EPHEMERAL_DISPLAY_RESOLUTION", "")),
            _env_line("EPHEMERAL_DISPLAY_FPS", package_env.get("EPHEMERAL_DISPLAY_FPS", "")),
            _env_line("PROVIDER", provider),
            _env_line("TIMEZONE", host_tz),
        ]
        for name in package_environment_names(selected_plugins):
            env_lines.append(_env_line(
                name, package_env.get(name, ""),
                remote_home=name in stage_env_names and bool(package_env.get(name)),
            ))
        env_path = stage / "state" / "env"
        _write_private_text(env_path, "\n".join(env_lines) + "\n")

        print(f"[provision] uploading {_provision_dir_display(os_provision_dir, root)}/ to remote")
        rc = _ssh_retry(profile, "prepare linux provision directory",
                        "rm -rf ~/provision/state ~/provision/scripts ~/provision/logs && mkdir -p ~/provision/state"
                        " && chmod 0700 ~/provision/state")
        if rc:
            return rc
        for local_path, remote_rel in stage_files:
            rc = _ssh_retry(profile, f"prepare {remote_rel}",
                            f"rm -rf ~/{remote_rel} && mkdir -p ~/{remote_rel}")
            if rc:
                return rc
            rc = _ssh_retry_scp(profile, f"upload {os.path.basename(local_path)}",
                                local_path, remote_rel)
            if rc:
                return rc
        rc = _ssh_retry_scp(profile, "upload linux scripts", str(stage / "scripts"), "provision/")
        if rc:
            return rc
        bundle_pkg_path = str(stage / "state" / "bundle_packages")
        rc = _ssh_retry_scp(profile, "upload linux bundle package list",
                            bundle_pkg_path, "provision/state/")
        if rc:
            return rc
        selected_pkg_path = str(stage / "state" / "selected_packages")
        rc = _ssh_retry_scp(profile, "upload linux selected package list",
                            selected_pkg_path, "provision/state/")
        if rc:
            return rc
        rc = _ssh_retry_scp(profile, "upload linux environment",
                            str(stage / "state" / "env"), "provision/state/")
        if rc:
            _ssh_retry(profile, "remove linux provision environment after upload failure",
                       "rm -f ~/provision/state/env")
            return rc
        rc = _ssh_retry(profile, "protect linux provision environment",
                        "chmod 0600 ~/provision/state/env")
        if rc:
            _ssh_retry(profile, "remove unprotected linux provision environment",
                       "rm -f ~/provision/state/env")
            return rc
        rc = _ssh_retry_scp(profile, "upload linux step list",
                            str(stage / "state" / "steps.list"), "provision/state/")
        if rc:
            _ssh_retry(profile, "remove linux provision environment after upload failure",
                       "rm -f ~/provision/state/env")
            return rc
        manifest_path = str(stage / "state" / "provision-manifest.json")
        rc = _ssh_retry_scp(profile, "upload linux provision manifest",
                            manifest_path, "provision/state/")
        if rc:
            _ssh_retry(profile, "remove linux provision environment after upload failure",
                       "rm -f ~/provision/state/env")
            return rc
        print("[provision] running bootstrap.sh")
        rc = _ssh_retry(profile, "start linux provisioning runner",
                        "chmod +x ~/provision/scripts/bootstrap.sh ~/provision/scripts/runner.sh"
                        " ~/provision/scripts/steps/*.sh ~/provision/scripts/lib/*.sh"
                        " && ~/provision/scripts/bootstrap.sh")
        if rc:
            _ssh_retry(profile, "remove linux provision environment after bootstrap failure",
                       "rm -f ~/provision/state/env")
            return rc
        poll_interval = os.environ.get("EVE_PROVISION_WAIT_POLL_INTERVAL", "5")
        print(f"[provision] waiting for linux provisioning to finish (polling remote log every {poll_interval}s)")
        rc = _run([str(root / "scripts/wait-for-provision"), profile]).returncode
        cleanup_rc = _ssh_retry(profile, "remove linux provision environment",
                                "rm -f ~/provision/state/env")
        return rc if rc else cleanup_rc
    finally:
        import shutil
        shutil.rmtree(stage, ignore_errors=True)


def provision_windows(profile: str, env: dict[str, str], root: Path) -> int:
    os_family = env.get("OS_FAMILY", "")
    os_id = env.get("OS_ID", "")
    bundle_packages = env.get("BUNDLE_PACKAGES", "")
    os_provision_dir = PluginManifest.os_provision_dir(os_id)
    if os_provision_dir is None:
        os_provision_dir = root / "oses" / os_id / "provision"

    windows_password = os.environ.get("EPHEMERAL_WINDOWS_PASSWORD", "")
    if not windows_password:
        # Dispatch to the provider's password command generically.
        pw_result = subprocess.run(
            [str(root / "scripts/provider-dispatch"),
             "--instance", profile, "--command", "password"],
            cwd=root, capture_output=True, text=True, check=False,
        )
        if pw_result.returncode == 0:
            windows_password = pw_result.stdout
        else:
            print(
                f"[provision] could not retrieve Windows password via provider "
                f"command (exit {pw_result.returncode})",
                file=sys.stderr,
            )
            return 1

    plugin_doc = json.loads(subprocess.run(
        [str(root / "scripts/plugin-list"), "--kind", "package", "--json"],
        cwd=root, capture_output=True, text=True, check=False,
    ).stdout)
    _selected_plugins, package_env = _selected_package_environment(
        plugin_doc, bundle_packages, profile
    )
    stage = Path(tempfile.mkdtemp())
    try:
        copytree(os_provision_dir, stage / "provision")
        env_names = package_environment_names(_selected_plugins)
        env_json = ConfigEnv.provision_env_payload(
            windows_password, package_env, env_names
        )
        state_dir = stage / "provision" / "state"
        state_dir.mkdir(parents=True, exist_ok=True)
        _write_private_text(
            state_dir / "env.json", json.dumps(env_json, indent=2) + "\n"
        )

        for plugin_path, step in _plugin_windows_steps(plugin_doc, bundle_packages):
            if not plugin_path or not step:
                continue
            plugin_root = Path(plugin_path).parent
            source: Path | None = None
            target = stage / "provision" / "scripts" / "steps" / Path(step).name
            os_step = os_provision_dir / "scripts" / "steps" / step
            if os_step.is_file():
                source = os_step
            elif (plugin_root / step).is_file():
                source = plugin_root / step
            if source is None:
                print(f"[provision] windows install step not found: {step}", file=sys.stderr)
                return 2
            copy2(source, target)
            if (plugin_root / "provision" / "windows" / "lib").is_dir():
                copytree(plugin_root / "provision" / "windows" / "lib",
                         stage / "provision" / "scripts" / "lib", dirs_exist_ok=True)
            if (plugin_root / "provision" / "windows" / "templates").is_dir():
                (stage / "provision" / "scripts" / "templates").mkdir(parents=True, exist_ok=True)
                copytree(plugin_root / "provision" / "windows" / "templates",
                         stage / "provision" / "scripts" / "templates", dirs_exist_ok=True)

        manifest_steps: list[dict] = []
        step_files = sorted((stage / "provision" / "scripts" / "steps").glob("*.ps1"))
        for idx, step_file in enumerate(step_files):
            manifest_steps.append({
                "order": idx,
                "name": step_file.name,
                "sha256": _sha256(step_file),
            })
        (stage / "provision" / "state").mkdir(parents=True, exist_ok=True)
        _write_manifest(stage / "provision" / "state", manifest_steps, os_family)

        print(f"[provision] uploading {_provision_dir_display(os_provision_dir, root)}/ to remote")
        rc = _ssh_retry(profile, "prepare windows provision directory",
                        'New-Item -ItemType Directory -Force C:\\Users\\Administrator\\provision | Out-Null; '
                        'if (Test-Path "C:\\Users\\Administrator\\provision\\scripts") { '
                        'Remove-Item -Recurse -Force "C:\\Users\\Administrator\\provision\\scripts" }; '
                        'if (Test-Path "C:\\Users\\Administrator\\provision\\state") { '
                        'Remove-Item -Recurse -Force "C:\\Users\\Administrator\\provision\\state" }; '
                        'if (Test-Path "C:\\Users\\Administrator\\provision\\logs") { '
                        'Remove-Item -Recurse -Force "C:\\Users\\Administrator\\provision\\logs" }; '
                        'New-Item -ItemType Directory -Force C:\\Users\\Administrator\\provision\\state | Out-Null; '
                        'icacls "C:\\Users\\Administrator\\provision\\state" /inheritance:r '
                        '/grant:r "Administrator:(OI)(CI)F" "SYSTEM:(OI)(CI)F" | Out-Null; '
                        'if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }')
        if rc:
            return rc
        rc = _ssh_retry_scp(profile, "upload windows provision tree",
                            str(stage / "provision"), "/C:/Users/Administrator/")
        if rc:
            _ssh_retry(
                profile, "remove windows provision environment after upload failure",
                windows_secret_cleanup(r"C:\Users\Administrator\provision\state\env.json"),
            )
            return rc
        rc = _ssh_retry(
            profile,
            "protect windows provision environment",
            'icacls "C:\\Users\\Administrator\\provision\\state\\env.json" '
            '/inheritance:r /grant:r "Administrator:F" "SYSTEM:F" | Out-Null; '
            'if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }',
        )
        if rc:
            _ssh_retry(
                profile,
                "remove unprotected windows provision environment",
                windows_secret_cleanup(r"C:\Users\Administrator\provision\state\env.json"),
            )
            return rc
        print("[provision] running bootstrap.ps1")
        instance_ssh = str(root / "scripts/instance-ssh")
        result = subprocess.run(
            [instance_ssh, profile, "--", '& "C:\\Users\\Administrator\\provision\\scripts\\bootstrap.ps1"'],
            cwd=root, check=False,
        )
        if result.returncode != 0 and result.returncode != 255:
            _ssh_retry(
                profile,
                "remove windows provision environment after bootstrap failure",
                windows_secret_cleanup(r"C:\Users\Administrator\provision\state\env.json"),
            )
            return result.returncode
        poll_interval = os.environ.get("EVE_PROVISION_WAIT_POLL_INTERVAL", "5")
        print(f"[provision] waiting for windows provisioning to finish (polling remote log every {poll_interval}s)")
        rc = _run([str(root / "scripts/wait-for-provision"), profile]).returncode
        cleanup_rc = _ssh_retry(
            profile,
            "remove windows provision environment",
            windows_secret_cleanup(r"C:\Users\Administrator\provision\state\env.json"),
        )
        return rc if rc else cleanup_rc
    finally:
        import shutil
        shutil.rmtree(stage, ignore_errors=True)


def main(argv: list[str]) -> int:
    load_runtime_env(ROOT)
    profile = argv[0] if argv else ""
    if not profile:
        print("Usage: scripts/provision <instance>", file=sys.stderr)
        return 2

    result = subprocess.run(
        [str(ROOT / "scripts/profile-resolve"), "--profile", profile, "--emit", "env"],
        cwd=ROOT, capture_output=True, text=True, check=False,
    )
    sys.stderr.write(result.stderr)
    if result.returncode != 0:
        return result.returncode
    env = _parse_env(result.stdout)

    os_family = env.get("OS_FAMILY", "")
    os_id = env.get("OS_ID", "")

    print(f"[provision] profile={profile} os={os_id} os_family={os_family}")

    if os_family == "ubuntu":
        return provision_ubuntu(profile, env, ROOT)
    if os_family == "windows":
        return provision_windows(profile, env, ROOT)
    print(f"[provision] unknown os_family: {os_family}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
