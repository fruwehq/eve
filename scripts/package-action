#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from eve_sdk.dispatch import (  # noqa: E402
    DispatchError,
    exec_cmd,
    prepare_overlay,
    process_environment,
    run_json,
)
from eve_sdk.package_dispatch import resolved_package_environment  # noqa: E402
from eve_sdk.plugin_manifest import PluginManifest  # noqa: E402
from eve_sdk.remote_launch import instance_ip, resolve_env  # noqa: E402
from eve_sdk.resolve import resolve_instance  # noqa: E402
from eve_sdk.workdir import Workdir  # noqa: E402


def usage() -> None:
    print(
        "Usage:\n  scripts/package-action --instance <name> --package <id> --action <id> [--dry-run]",
        file=sys.stderr,
    )


def parse_args(argv: list[str]) -> tuple[str, str, str, bool]:
    instance_name: str | None = None
    package_id: str | None = None
    action_id: str | None = None
    dry_run = False
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--instance" and args:
            instance_name = args.pop(0)
        elif arg == "--package" and args:
            package_id = args.pop(0)
        elif arg == "--action" and args:
            action_id = args.pop(0)
        elif arg == "--dry-run":
            dry_run = True
        elif arg in {"-h", "--help"}:
            usage()
            raise SystemExit(0)
        else:
            usage()
            raise SystemExit(2)
    if not instance_name or not package_id or not action_id:
        usage()
        raise SystemExit(2)
    return instance_name, package_id, action_id, dry_run


# ---- generic launcher path (v4.4 §8) ------------------------------------- #
def export_remote_context(
    root: Path,
    instance_name: str,
    target: str,
    base_env: dict[str, str],
) -> dict[str, str]:
    """Resolve the shared launcher context for a package exec.

    The documented stable contract is the ``EVE_REMOTE_*`` set below; the full
    ``profile-resolve`` env (incl. ``BUNDLE_PACKAGES``, ``OS_FAMILY``,
    ``ENGINE``, ``VM_USER_NAME``) is exported as passthrough so package launchers
    keep working. No package id appears here — this spine is identical for every
    client.
    """
    profile_env = resolve_env(root, instance_name)
    ip = instance_ip(root, instance_name)
    env = dict(base_env)
    env.update(profile_env)
    key_file = env.get("SSH_PUBLIC_KEY_FILE", "")
    private_key = key_file[:-4] if key_file.endswith(".pub") else env.get(
        "SSH_PRIVATE_KEY_FILE", ""
    )
    env.update(
        {
            "EVE_REMOTE_IP": ip,
            "EVE_REMOTE_USER": profile_env.get("VM_USER_NAME") or profile_env.get("SSH_USER", ""),
            "EVE_REMOTE_KEY": private_key,
            "EVE_REMOTE_OS_FAMILY": profile_env.get("OS_FAMILY", ""),
            "EVE_REMOTE_ENGINE": profile_env.get("ENGINE", ""),
            "EVE_REMOTE_ACTION": target,
            # Lets package launchers reach core's generic services (instance-ssh
            # for remote state, instance-password) and know which instance they
            # act on — without core interpreting any target/package string.
            "EVE_REMOTE_ROOT": str(root),
            "EVE_REMOTE_INSTANCE": instance_name,
        }
    )
    return env


def exec_launcher(
    exec_rel: str,
    package: dict[str, Any],
    target: str,
    env: dict[str, str],
) -> None:
    """Resolve an action ``exec`` (relative to the plugin dir) and run it.

    Receives only the operation-local package and ``EVE_REMOTE_*`` environment.
    """
    plugin_dir = Path(str(package.get("path", ""))).resolve().parent
    exec_path = Path(exec_rel)
    if not exec_path.is_absolute():
        exec_path = (plugin_dir / exec_rel).resolve()
    if not exec_path.is_file():
        raise DispatchError(f"launcher exec not found for action {target}: {exec_rel}")
    exec_cmd([str(exec_path)], env)


def run_action_target(
    action: dict[str, Any],
    package: dict[str, Any],
    instance_name: str,
    target_map: dict[str, dict[str, Any]],
    root: Path,
    resolved: dict[str, Any],
    operation_env: dict[str, str],
) -> None:
    """Dispatch a package action to its declared launcher command.

    Pure generic dispatch (v4.4 §8): the action's ``exec`` is resolved relative
    to the plugin dir and run with the shared ``EVE_REMOTE_*`` context exported.
    ``wait_for`` runs another action target first. No target string is
    interpreted by core and no package id appears here — a missing ``exec`` is a
    hard error (no fallback).
    """
    target = action["target"]
    wait_for = action.get("wait_for")
    if wait_for:
        wf = target_map.get(wait_for)
        if wf is None:
            raise DispatchError(f"wait_for target not found: {wait_for}")
        run_action_target(
            wf["action"],
            wf["package"],
            instance_name,
            target_map,
            root,
            resolved,
            operation_env,
        )

    exec_rel = action.get("exec")
    if not exec_rel:
        raise DispatchError(
            f"action {target} has no 'exec' launcher; the owning package must declare one"
        )
    package_env = resolved_package_environment(package, resolved, operation_env)
    remote_env = export_remote_context(root, instance_name, target, package_env)
    exec_launcher(exec_rel, package, target, remote_env)


def main(argv: list[str]) -> int:
    instance_name, package_id, action_id, dry_run = parse_args(argv)
    try:
        # Registry selection is a transport concern, not package configuration.
        inherited = process_environment()
        registry_path = inherited.get("EVE_INSTANCE_REGISTRY")
        resolved = resolve_instance(instance_name, registry_path)
        doc = run_json(str(Workdir.repo_root() / "scripts/package-list"), "--instance", instance_name, "--json")
        package_view = next(
            (entry for entry in doc["packages"] if entry["id"] == package_id), None
        )
        if package_view is None:
            raise DispatchError(f"unknown package: {package_id}")
        installed_packages = {
            str(plugin["id"]): PluginManifest.public(plugin)
            for plugin in PluginManifest.load_all("package")
        }
        package = installed_packages.get(package_id)
        if package is None:
            raise DispatchError(f"package plugin not found: {package_id}")
        action = next((entry for entry in package.get("actions", []) if entry["id"] == action_id), None)
        if action is None:
            raise DispatchError(f"unknown action {action_id} for package {package_id}")
        if dry_run:
            print(
                json.dumps(
                    {
                        "kind": "package-action",
                        "instance": instance_name,
                        "package": package_id,
                        "action": action_id,
                        "label": action["label"],
                        "target": action["target"],
                        "exec": action.get("exec"),
                        "wait_for": action.get("wait_for"),
                        "dry_run": True,
                    },
                    indent=2,
                )
            )
            return 0
        overlay = prepare_overlay(instance_name, registry_path)
        operation_env = {"EVE_CATALOG_LOCAL": overlay, "EVE_INSTANCE_NAME": instance_name}
        if registry_path:
            operation_env["EVE_INSTANCE_REGISTRY"] = registry_path
        # target -> {package, action} for wait_for resolution.
        target_map: dict[str, dict[str, Any]] = {}
        for pkg_view in doc["packages"]:
            full_package = installed_packages.get(str(pkg_view["id"]))
            if full_package is None:
                continue
            for act in full_package.get("actions", []):
                target_map[act["target"]] = {
                    "action": act,
                    "package": full_package,
                }
        run_action_target(
            action,
            package,
            instance_name,
            target_map,
            Workdir.repo_root(),
            resolved,
            operation_env,
        )
        return 0
    except SystemExit as error:
        raise error
    except Exception as error:
        print(f"package-action: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
